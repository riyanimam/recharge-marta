PORT=8080

# Poll interval accepts seconds (e.g. 30) or duration (e.g. 30s)
MARTA_POLL_INTERVAL=30s

# Optional API key that will be appended as `apikey` query param if missing.
MARTA_API_KEY=

# Live sources (set at least one to enable live ingestion)
# MARTA Rail arrivals endpoint (JSON)
MARTA_RAIL_ARRIVALS_URL=https://developerservices.itsmarta.com:18096/itsmarta/railrealtimearrivals/developerservices/traindata

# GTFS-RT Service Alerts endpoint (protobuf) - optional
MARTA_GTFSRT_ALERTS_URL=

# GTFS-RT Vehicle Positions endpoint (protobuf)
MARTA_GTFSRT_VEHICLE_URL=https://gtfs-rt.itsmarta.com/TMGTFSRealTimeWebService/vehicle

# GTFS-RT Trip Updates endpoint (protobuf)
MARTA_GTFSRT_TRIPUPDATE_URL=https://gtfs-rt.itsmarta.com/TMGTFSRealTimeWebService/tripupdate

# Elevator/escalator equipment status endpoint (JSON array)
MARTA_EQUIPMENT_STATUS_URL=
